{
  "name": "pantrybridge-demo",
  "version": "1.0.0",
  "private": true,
  "description": "PantryBridge – clickable client-management demo for Sunrise Community Alliance (fictional). Builds to one self-contained index.html.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
